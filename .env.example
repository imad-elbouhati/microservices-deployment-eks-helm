# Copy this file to .env and fill in real values for local docker-compose use.
# Never commit the populated .env file.

# RapidAPI "WeatherAPI" key used by the weather service.
APIKEY=

# MySQL root password used by the auth service's database.
MYSQL_ROOT_PASSWORD=

# Signing secret for JWTs issued by the auth service and verified by the UI service.
# Must be identical for both services.
JWT_SECRET=
